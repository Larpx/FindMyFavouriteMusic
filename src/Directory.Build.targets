<Project>
  <!--
    CopyOpenVinoNativeLibs：把 OpenVINO EP 的 native 库复制到输出目录的 ep-openvino/ 子目录。
    仅在项目引用了 OpenVINO native 包（GeneratePathProperty=true 生成 $(Pkg...) 变量）时执行。
    运行时由 EpNativeLoader 把该子目录的 dll 复制到输出根目录后再加载 ORT。
    v2.0 起移除 DirectML EP，仅保留 OpenVINO + CPU 双 EP 架构。
  -->
  <Target Name="CopyOpenVinoNativeLibs" AfterTargets="AfterBuild"
          Condition="'$(PkgIntel_ML_OnnxRuntime_OpenVino)' != ''">
    <PropertyGroup>
      <OpenVinoNativeDir>$(PkgIntel_ML_OnnxRuntime_OpenVino)\runtimes\win-x64\native</OpenVinoNativeDir>
    </PropertyGroup>
    <ItemGroup>
      <OpenVinoNativeLibs Include="$(OpenVinoNativeDir)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(OpenVinoNativeLibs)" DestinationFolder="$(OutDir)ep-openvino\%(RecursiveDir)" Condition="Exists('$(OpenVinoNativeDir)')" SkipUnchangedFiles="true" />
    <Message Text="已复制 OpenVINO native 库到 $(OutDir)ep-openvino\" Importance="high" />
  </Target>
</Project>
