<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Larpx.PersonalTools.FindMyFavouriteMusic.GUI.ViewModels"
             xmlns:cvt="using:Larpx.PersonalTools.FindMyFavouriteMusic.GUI.Converters"
             xmlns:dto="using:Larpx.PersonalTools.FindMyFavouriteMusic.Models.Dtos"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="750" d:DesignHeight="700"
             x:Class="Larpx.PersonalTools.FindMyFavouriteMusic.GUI.Views.PredictionView"
             x:DataType="vm:PredictionViewModel"
             Background="{StaticResource BrushBgBase}">

    <UserControl.Resources>
        <cvt:ScoreToColorConverter x:Key="ScoreToColorConverter"/>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="24,20,24,20" Spacing="20">
            <!-- 页面标题 -->
            <TextBlock Text="音乐喜好预测" Classes="page-title"/>

            <!-- 文件选择 / 拖拽上传区域 -->
            <Border Classes="card-accent"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragEnter="OnDragEnter"
                    DragDrop.DragLeave="OnDragLeave"
                    DragDrop.Drop="OnDrop"
                    x:Name="DropZone">
                <StackPanel Spacing="12">
                    <TextBlock Text="选择音乐文件" Classes="section-title"/>
                    <TextBlock Text="拖拽音频文件到此处，或点击浏览按钮选择文件（支持多文件拖拽进行批量预测）"
                               Classes="label-text" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding SelectedFilePath}"
                                 PlaceholderText="文件路径"
                                 Classes="sci-input"
                                 Grid.Column="0" IsReadOnly="True"/>
                        <Button Content="浏览"
                                Classes="outline-btn"
                                Command="{Binding SelectFileCommand}"
                                Grid.Column="1"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 操作按钮 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="开始预测"
                        Classes="accent-btn"
                        Command="{Binding PredictCommand}"
                        HorizontalAlignment="Left"/>
                <Button Content="批量预测"
                        Classes="outline-btn"
                        Command="{Binding BatchPredictCommand}"
                        HorizontalAlignment="Left"/>
            </StackPanel>

            <!-- 预测进度区域（仅预测时显示） -->
            <Border Classes="card" IsVisible="{Binding IsPredicting}" Padding="16">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding ProgressDescription}"
                                   Classes="label-text" VerticalAlignment="Center"/>
                        <ProgressBar Classes="sci-progress-lg"
                                     Value="{Binding PredictionProgress}"
                                     Minimum="0" Maximum="100"
                                     Grid.Column="1" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PredictionProgress, StringFormat='{}{0}%'}"
                                   Classes="value-text" Grid.Column="2"
                                   Width="40" TextAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 预测结果区域 -->
            <Border Classes="card">
                <StackPanel Spacing="20">
                    <TextBlock Text="预测结果" Classes="section-title"/>

                    <!-- 得分主展示区 -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24">
                        <!-- 大号得分 -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Width="140" Height="140">
                            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding PredictionScore, StringFormat='{}{0:F1}%'}"
                                           FontSize="{StaticResource Text3xl}"
                                           FontWeight="Bold"
                                           Foreground="{Binding PredictionScore, Converter={StaticResource ScoreToColorConverter}}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- 得分详情 -->
                        <StackPanel Spacing="16" VerticalAlignment="Center" Grid.Column="1">
                            <!-- 匹配度进度条 -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <TextBlock Text="匹配度" Classes="label-text" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding PredictionScore, StringFormat='{}{0:F1}%'}"
                                               FontWeight="Bold" FontSize="{StaticResource TextLg}"
                                               Foreground="{Binding PredictionScore, Converter={StaticResource ScoreToColorConverter}}"
                                               Grid.Column="1" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar Classes="sci-progress-lg"
                                             Value="{Binding PredictionScore}" Minimum="0" Maximum="100"/>
                            </StackPanel>

                            <!-- 声学特征得分 -->
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <TextBlock Text="声学特征" Classes="label-text" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AcousticScore, StringFormat='{}{0:F1}%'}"
                                               Classes="value-text"
                                               Grid.Column="1" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar Classes="sci-progress"
                                             Value="{Binding AcousticScore}" Minimum="0" Maximum="100"/>
                            </StackPanel>

                            <!-- 深度特征得分 -->
                            <StackPanel Spacing="4">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <TextBlock Text="深度特征" Classes="label-text" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DeepScore, StringFormat='{}{0:F1}%', TargetNullValue='不可用'}"
                                               Classes="value-text"
                                               Grid.Column="1" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar Classes="sci-progress"
                                             Value="{Binding DeepScore, TargetNullValue=0}" Minimum="0" Maximum="100"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 模式标签 + 模型类型 -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="{StaticResource BrushPrimaryGhost}"
                                CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding CurrentMode}"
                                       Foreground="{StaticResource BrushPrimary}"
                                       FontSize="{StaticResource TextSm}" FontWeight="Medium"/>
                        </Border>
                        <Border Background="{StaticResource BrushPrimaryGhost}"
                                CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                            <TextBlock Foreground="{StaticResource BrushPrimary}"
                                       FontSize="{StaticResource TextSm}" FontWeight="Medium">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="模型: {0}">
                                        <Binding Path="ModelTypeText"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 历史分数展示区域 -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Text="预测历史" Classes="section-title" VerticalAlignment="Center"/>
                        <Button Content="导出"
                                Classes="ghost-btn"
                                Command="{Binding ExportHistoryCommand}"
                                FontSize="{StaticResource TextSm}"
                                Grid.Column="1"
                                IsVisible="{Binding HistoryItems.Count, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <Button Content="清空"
                                Classes="ghost-btn"
                                Command="{Binding ClearHistoryCommand}"
                                FontSize="{StaticResource TextSm}"
                                Grid.Column="2"
                                IsVisible="{Binding HistoryItems.Count, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    </Grid>

                    <!-- 无历史记录时的占位提示 -->
                    <TextBlock Text="暂无预测记录，选择音乐文件开始预测"
                               Classes="label-text"
                               HorizontalAlignment="Center"
                               Margin="0,24,0,24"
                               IsVisible="{Binding HistoryItems.Count, Converter={x:Static ObjectConverters.IsNull}}"/>

                    <!-- 历史记录表格 -->
                    <DataGrid ItemsSource="{Binding HistoryItems}" AutoGenerateColumns="False"
                              CanUserResizeColumns="True" IsReadOnly="True"
                              SelectionMode="Single" GridLinesVisibility="Horizontal"
                              BorderThickness="0" CornerRadius="8"
                              MaxHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="*"/>
                            <DataGridTextColumn Header="综合分数" Binding="{Binding Score, StringFormat='{}{0}%'}" Width="80"/>
                            <DataGridTextColumn Header="检测类型" Binding="{Binding ModeText}" Width="90"/>
                            <DataGridTextColumn Header="声学分数" Binding="{Binding AcousticScore, StringFormat='{}{0}%'}" Width="80"/>
                            <DataGridTextColumn Header="深度分数" Binding="{Binding DeepScore, StringFormat='{}{0}%', TargetNullValue='-'}" Width="80"/>
                            <DataGridTextColumn Header="模型" Binding="{Binding ModelType}" Width="70"/>
                            <DataGridTextColumn Header="路径" Binding="{Binding FilePath}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- 状态消息 -->
            <TextBlock Text="{Binding StatusMessage}" Classes="label-text"/>
        </StackPanel>
    </ScrollViewer>

</UserControl>
