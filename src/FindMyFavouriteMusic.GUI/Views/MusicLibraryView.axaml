<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Larpx.PersonalTools.FindMyFavouriteMusic.GUI.ViewModels"
             xmlns:dto="using:Larpx.PersonalTools.FindMyFavouriteMusic.Models.Dtos"
             xmlns:cvt="using:Larpx.PersonalTools.FindMyFavouriteMusic.GUI.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="Larpx.PersonalTools.FindMyFavouriteMusic.GUI.Views.MusicLibraryView"
             x:DataType="vm:MusicLibraryViewModel"
             Background="{StaticResource BrushBgBase}">

    <UserControl.Resources>
        <cvt:BoolToLikeIconConverter x:Key="BoolToLikeIconConverter"/>
    </UserControl.Resources>

    <DockPanel Margin="24,20,24,20">
        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,20">
            <TextBlock Text="音乐库" Classes="page-title"/>
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                <Button Classes="accent-btn" Content="扫描目录"
                        Command="{Binding ScanDirectoryCommand}"
                        IsEnabled="{Binding !IsScanning}"/>
                <Button Classes="outline-btn" Content="刷新列表"
                        Command="{Binding LoadAllSongsCommand}" Grid.Column="1"/>
                <ProgressBar Classes="sci-progress"
                             Value="{Binding ScanProgress}" Minimum="0" Maximum="100"
                             IsVisible="{Binding IsScanning}" Grid.Column="2"
                             VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock Text="{Binding StatusMessage}" Classes="label-text"
                           Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top"
                   Text="支持拖拽文件夹到下方列表区域快速扫描；单击歌曲查看右侧详情并可编辑标签"
                   Foreground="{StaticResource BrushTextMuted}"
                   FontSize="{StaticResource FontXs}" Margin="0,4,0,8"/>

        <Grid ColumnDefinitions="*,12,360">
            <!-- 左侧列表 -->
            <Border Classes="card" Padding="0"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragEnter="OnFolderDragEnter"
                    DragDrop.DragLeave="OnFolderDragLeave"
                    DragDrop.Drop="OnFolderDrop"
                    x:Name="FolderDropZone">
                <DataGrid ItemsSource="{Binding Songs}" AutoGenerateColumns="False"
                          CanUserResizeColumns="True" IsReadOnly="True"
                          SelectionMode="Single" GridLinesVisibility="Horizontal"
                          SelectedItem="{Binding SelectedSong}"
                          BorderThickness="0" CornerRadius="8">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="查看详情"
                                      Command="{Binding ViewDetailCommand}"
                                      CommandParameter="{Binding SelectedSong}"/>
                            <MenuItem Header="编辑标签"
                                      Command="{Binding ViewDetailCommand}"
                                      CommandParameter="{Binding SelectedSong}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="艺术家" Binding="{Binding Artist}" Width="120"/>
                        <DataGridTextColumn Header="文件名" Binding="{Binding FilePath}" Width="160"/>
                        <DataGridTemplateColumn Header="喜欢" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="dto:SongDto">
                                    <Button Content="{Binding IsLiked, Converter={StaticResource BoolToLikeIconConverter}}"
                                            Command="{Binding $parent[DataGrid].((vm:MusicLibraryViewModel)DataContext).ToggleLikeCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="ghost-btn" FontSize="16" Padding="4,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 右侧详情 -->
            <Border Grid.Column="2" Classes="card" Padding="16">
                <Panel>
                    <TextBlock Text="选中歌曲以查看与编辑详情"
                               IsVisible="{Binding !IsDetailVisible}"
                               Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap"/>

                    <ScrollViewer IsVisible="{Binding IsDetailVisible}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="歌曲详情" Classes="section-title"/>

                            <Border Background="#0d1117" CornerRadius="6" Height="160"
                                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
                                <Panel>
                                    <TextBlock Text="无封面" Foreground="{StaticResource BrushTextMuted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding DetailCover, Converter={x:Static ObjectConverters.IsNull}}"/>
                                    <Image Source="{Binding DetailCover}" Stretch="Uniform"
                                           IsVisible="{Binding DetailCover, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                </Panel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="更换封面" Classes="outline-btn"
                                        Command="{Binding ChangeCoverCommand}"
                                        IsEnabled="{Binding !IsDetailReadOnly}"/>
                                <Button Content="清除封面" Classes="ghost-btn"
                                        Command="{Binding ClearCoverCommand}"
                                        IsEnabled="{Binding !IsDetailReadOnly}"/>
                            </StackPanel>

                            <TextBlock Text="标题" Classes="label-text"/>
                            <TextBox Text="{Binding DetailTitle}" Classes="sci-input" IsReadOnly="{Binding IsDetailReadOnly}"/>
                            <TextBlock Text="艺术家" Classes="label-text"/>
                            <TextBox Text="{Binding DetailArtist}" Classes="sci-input" IsReadOnly="{Binding IsDetailReadOnly}"/>
                            <TextBlock Text="专辑" Classes="label-text"/>
                            <TextBox Text="{Binding DetailAlbum}" Classes="sci-input" IsReadOnly="{Binding IsDetailReadOnly}"/>
                            <TextBlock Text="专辑艺术家" Classes="label-text"/>
                            <TextBox Text="{Binding DetailAlbumArtist}" Classes="sci-input" IsReadOnly="{Binding IsDetailReadOnly}"/>
                            <TextBlock Text="流派" Classes="label-text"/>
                            <TextBox Text="{Binding DetailGenre}" Classes="sci-input" IsReadOnly="{Binding IsDetailReadOnly}"/>
                            <TextBlock Text="年份" Classes="label-text"/>
                            <TextBox Text="{Binding DetailYear}" Classes="sci-input" IsReadOnly="{Binding IsDetailReadOnly}"/>
                            <TextBlock Text="曲目号" Classes="label-text"/>
                            <TextBox Text="{Binding DetailTrack}" Classes="sci-input" PlaceholderText="如 3 或 3/12" IsReadOnly="{Binding IsDetailReadOnly}"/>
                            <TextBlock Text="碟号" Classes="label-text"/>
                            <TextBox Text="{Binding DetailDisc}" Classes="sci-input" IsReadOnly="{Binding IsDetailReadOnly}"/>
                            <TextBlock Text="注释" Classes="label-text"/>
                            <TextBox Text="{Binding DetailComment}" Classes="sci-input" IsReadOnly="{Binding IsDetailReadOnly}"/>
                            <TextBlock Text="歌词" Classes="label-text"/>
                            <TextBox Text="{Binding DetailLyrics}" Classes="sci-input" AcceptsReturn="True"
                                     Height="100" TextWrapping="Wrap" IsReadOnly="{Binding IsDetailReadOnly}"/>

                            <Border Background="{StaticResource BrushPrimaryGhost}" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="只读信息" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                                    <TextBlock Text="{Binding DetailFilePath}" TextWrapping="Wrap" FontSize="{StaticResource FontXs}" Foreground="{StaticResource BrushTextMuted}"/>
                                    <TextBlock Text="{Binding DetailFormat, StringFormat=格式: {0}}" FontSize="{StaticResource FontXs}" Foreground="{StaticResource BrushTextMuted}"/>
                                    <TextBlock Text="{Binding DetailFileSize, StringFormat=大小: {0}}" FontSize="{StaticResource FontXs}" Foreground="{StaticResource BrushTextMuted}"/>
                                    <TextBlock Text="{Binding DetailDuration, StringFormat=时长: {0}}" FontSize="{StaticResource FontXs}" Foreground="{StaticResource BrushTextMuted}"/>
                                    <TextBlock Text="{Binding DetailMd5, StringFormat=MD5: {0}}" FontSize="{StaticResource FontXs}" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding DetailFeatureStatus}" FontSize="{StaticResource FontXs}" Foreground="{StaticResource BrushTextMuted}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Content="保存到原文件" Classes="accent-btn"
                                        Command="{Binding SaveDetailCommand}"
                                        IsEnabled="{Binding !IsDetailReadOnly}"/>
                                <Button Content="放弃修改" Classes="outline-btn"
                                        Command="{Binding DiscardDetailCommand}"/>
                            </StackPanel>
                            <TextBlock Text="有未保存修改" IsVisible="{Binding IsDetailDirty}"
                                       Foreground="#f0a020" FontSize="{StaticResource FontXs}"/>
                            <TextBlock Text="文件只读，无法保存" IsVisible="{Binding IsDetailReadOnly}"
                                       Foreground="#ff6b6b" FontSize="{StaticResource FontXs}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Panel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
